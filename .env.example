# floatlab-control configuration
# Copy to .env and adjust for your environment. Never commit .env.

# HTTP API
LISTEN_ADDR=:8080

# rqlite
RQLITE_URL=http://rqlite:4001

# Raft
RAFT_ID=node1
RAFT_BIND=0.0.0.0:7000
RAFT_ADVERTISE=192.168.1.10:7000
RAFT_DATA=/var/lib/floatlab/raft
RAFT_BOOTSTRAP=false

# VictoriaMetrics
VM_URL=http://victoriametrics:8428

# VictoriaLogs
VL_URL=http://victorialogs:9428

# Memory limits (applied to containers via Docker Compose)
GOGC=100
GOMEMLIMIT=256MiB

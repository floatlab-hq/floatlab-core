[Unit]
Description=FloatLab host daemon
Requires=systemd-networkd.service systemd-resolved.service
After=systemd-networkd.service systemd-resolved.service
Before=network-online.target

[Service]
ExecStart=/usr/local/bin/floatlab-hostd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target


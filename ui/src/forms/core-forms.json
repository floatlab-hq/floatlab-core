  "AlertRuleCreate": {
    "name": "AlertRuleCreate",
    "fields": [
      {
        "key": "name",
        "label": "name",
        "type": "string",
        "required": true
      },
      {
        "key": "condition",
        "label": "condition",
        "type": "string",
        "required": true,
        "description": "Filtered MetricsQL predicate. Every returned series is a match, including a zero-valued\nsample. Use filtering comparisons, not the bool modifier. Empty results are unknown,\nnot recovery. Configure recovery_condition to resolve on positive healthy evidence.\nAggregate away volatile labels such as container_id for stable resource identity."
      },
      {
        "key": "severity",
        "label": "severity",
        "type": "enum",
        "required": true,
        "options": [
          {
            "value": "info",
            "label": "info"
          },
          {
            "value": "warning",
            "label": "warning"
          },
          {
            "value": "critical",
            "label": "critical"
          }
        ]
      },
      {
        "key": "stack_id",
        "label": "stack id",
        "type": "string",
        "required": false
      },
      {
        "key": "node_id",
        "label": "node id",
        "type": "string",
        "required": false
      },
      {
        "key": "for_duration",
        "label": "for duration",
        "type": "string",
        "required": false
      },
      {
        "key": "freshness_query",
        "label": "freshness query",
        "type": "string",
        "required": true,
        "description": "MetricsQL query returning source observation Unix timestamps with the same resource labels. Required for enabled rules; derived queries must return the oldest required source timestamp."
      },
      {
        "key": "recovery_condition",
        "label": "recovery condition",
        "type": "string",
        "required": true,
        "description": "Filtered healthy predicate with the same resource labels as condition. Required for enabled rules; missing telemetry never resolves an incident."
      },
      {
        "key": "recovery_duration",
        "label": "recovery duration",
        "type": "string",
        "required": false,
        "description": "Duration of fresh healthy evidence required to resolve; Go duration syntax, zero allowed.",
        "default": "1m"
      },
      {
        "key": "max_sample_age",
        "label": "max sample age",
        "type": "string",
        "required": false,
        "description": "Maximum observation age and implicit MetricsQL lookback; positive Go duration.",
        "default": "2m"
      },
      {
        "key": "annotations",
        "label": "annotations",
        "type": "json",
        "required": false
      },
      {
        "key": "enabled",
        "label": "enabled",
        "type": "boolean",
        "required": false,
        "default": true
      }
    ]
  },
  "StackCreate": {

{
  "name": "floatlab-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-typescript ../api/openapi/openapi.yaml -o src/api/schema.d.ts",
    "lint": "eslint .",
    "predev": "pnpm generate:api",
    "prebuild": "pnpm generate:api",
    "build": "vue-tsc --noEmit && eslint . && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.7"
  }
}

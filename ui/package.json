{
  "name": "floatlab-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "story:preview": "histoire preview",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "storybook:build": "storybook build",
    "theme:add": "node --experimental-strip-types scripts/add-theme.ts",
    "forms:sync": "node scripts/sync-core-forms.mjs",
    "storybook:publish": "bash scripts/publish-storybook.sh"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tabler/icons-vue": "^3.49.0",
    "smol-toml": "^1.9.1",
    "vue": "^3.5.41",
    "@floatlab/client": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@histoire/plugin-vue": "1.0.0-beta.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/vue3-vite": "^10.6.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "histoire": "1.0.0-beta.1",
    "jsdom": "^30.0.1",
    "storybook": "^10.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "yaml": "^2.9.1"
  }
}

                  "name": "--path-id",
                  "required": true,
                  "arguments": [
                    {
                      "name": "id",
                      "required": true
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "DELETE",
                      "path": "/nodes/{id}",
                      "parameters": [
                        {
                          "name": "id",
                          "in": "path",
                          "option": "--path-id",
                          "required": true,
                          "schema": {
                            "type": "string",
                            "format": "uuid"
                          }
                        }
                      ]
                    },
                    "api": [
                      {
                        "operationId": "deleteNode",
                        "inputs": {
                          "path/id": "option:--path-id"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {

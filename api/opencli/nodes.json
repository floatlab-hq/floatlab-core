                  "arguments": [
                    {
                      "name": "body",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--body-file",
                  "description": "Read the request body from a file as raw bytes (CLI only); mutually exclusive with --body",
                  "arguments": [
                    {
                      "name": "path",
                      "required": true,
                      "metadata": [
                        {
                          "name": "floatlab",
                          "value": {
                            "provider": "files"
                          }
                        }
                      ]
                    }
                  ],
                  "metadata": [
                    {
                      "name": "floatlab",
                      "value": {
                        "capability": "files"
                      }
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "PUT",
                      "path": "/nodes/{id}",
                      "parameters": [
                        {
                          "name": "id",
                          "in": "path",
                          "option": "--path-id",
                          "required": true,
                          "schema": {
                            "type": "string",
                            "format": "uuid"
                          }
                        }
                      ],
                      "requestBody": {
                        "required": true,
                        "content": {
                          "application/json": {
                            "schema": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string"
                                },
                                "hostname": {
                                  "type": "string"
                                },
                                "addresses": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "required": [
                                      "type",
                                      "address",
                                      "interface"
                                    ],
                                    "properties": {
                                      "type": {
                                        "type": "string",
                                        "enum": [
                                          "LAN-6",
                                          "WAN-6",
                                          "Overlay-6"
                                        ],
                                        "description": "IPv6 address role. All addresses are native IPv6 (no SIIT/NAT64 in MVP — see DEV-002)."
                                      },
                                      "address": {
                                        "type": "string",
                                        "description": "IPv6 address in CIDR notation.",
                                        "example": "2001:db8::1/64"
                                      },
                                      "interface": {
                                        "type": "string",
                                        "example": "eth0"
                                      }
                                    }
                                  }
                                },
                                "role": {
                                  "type": "string",
                                  "enum": [
                                    "primary",
                                    "secondary"
                                  ]
                                },
                                "zfs_pool": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      },
                      "accept": "application/json"
                    },
                    "api": [
                      {
                        "operationId": "updateNode",
                        "inputs": {
                          "path/id": "option:--path-id",
                          "body": "option:--body"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}

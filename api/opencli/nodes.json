                        "operationId": "listNodes",
                        "inputs": {}
                      }
                    ]
                  }
                }
              ]
            },
            {
              "name": "registerNode",
              "description": "Register a new node",
              "options": [
                {
                  "name": "--body",
                  "description": "Request body: JSON for JSON media, literal text otherwise; mutually exclusive with --body-file",
                  "arguments": [
                    {
                      "name": "body",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--body-file",
                  "description": "Read the request body from a file as raw bytes (CLI only); mutually exclusive with --body",
                  "arguments": [
                    {
                      "name": "path",
                      "required": true,
                      "metadata": [
                        {
                          "name": "floatlab",
                          "value": {
                            "provider": "files"
                          }
                        }
                      ]
                    }
                  ],
                  "metadata": [
                    {
                      "name": "floatlab",
                      "value": {
                        "capability": "files"
                      }
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "POST",
                      "path": "/nodes",
                      "parameters": [],
                      "requestBody": {
                        "required": true,
                        "content": {
                          "application/json": {
                            "schema": {
                              "type": "object",
                              "required": [
                                "name",
                                "hostname",
                                "zfs_pool"
                              ],
                              "properties": {
                                "name": {
                                  "type": "string"
                                },
                                "hostname": {
                                  "type": "string"
                                },
                                "addresses": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "required": [
                                      "type",
                                      "address",
                                      "interface"
                                    ],
                                    "properties": {
                                      "type": {
                                        "type": "string",
                                        "enum": [
                                          "LAN-6",
                                          "WAN-6",
                                          "Overlay-6"
                                        ],
                                        "description": "IPv6 address role. All addresses are native IPv6 (no SIIT/NAT64 in MVP — see DEV-002)."
                                      },
                                      "address": {
                                        "type": "string",
                                        "description": "IPv6 address in CIDR notation.",
                                        "example": "2001:db8::1/64"
                                      },
                                      "interface": {
                                        "type": "string",
                                        "example": "eth0"
                                      }
                                    }
                                  }
                                },
                                "role": {
                                  "default": "secondary",
                                  "type": "string",
                                  "enum": [
                                    "primary",
                                    "secondary"
                                  ]
                                },
                                "zfs_pool": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      },
                      "accept": "application/json"
                    },
                    "api": [
                      {
                        "operationId": "registerNode",
                        "inputs": {
                          "body": "option:--body"
                        }
                      }
                    ]
                  }
                }
              ]
            },

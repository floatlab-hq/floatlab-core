    {
      "name": "api",
      "description": "Call the HTTP API directly",
      "commands": [
        {
          "name": "updates",
          "commands": [
            {
              "name": "getUpdateStatus",
              "description": "Read hostd's durable update status without querying rqlite",
              "options": [
                {
                  "name": "--path-id",
                  "required": true,
                  "arguments": [
                    {
                      "name": "id",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--path-component",
                  "required": true,
                  "arguments": [
                    {
                      "name": "component",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--query-operation-id",
                  "arguments": [
                    {
                      "name": "operation_id",
                      "required": true
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "GET",
                      "path": "/nodes/{id}/updates/{component}/status",
                      "parameters": [
                        {
                          "name": "id",
                          "in": "path",
                          "option": "--path-id",
                          "required": true,
                          "schema": {
                            "type": "string"
                          }
                        },
                        {
                          "name": "component",
                          "in": "path",
                          "option": "--path-component",
                          "required": true,
                          "schema": {
                            "type": "string",
                            "enum": [
                              "management",
                              "host"
                            ]
                          }
                        },
                        {
                          "name": "operation_id",
                          "in": "query",
                          "option": "--query-operation-id",
                          "schema": {
                            "type": "string"
                          }
                        }
                      ],
                      "accept": "application/json"
                    },
                    "api": [
                      {
                        "operationId": "getUpdateStatus",
                        "inputs": {
                          "path/id": "option:--path-id",
                          "path/component": "option:--path-component",
                          "query/operation_id": "option:--query-operation-id"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "name": "listUpdateReleases",
              "description": "List immutable releases for a local appliance update",
              "options": [
                {
                  "name": "--path-id",
                  "required": true,
                  "arguments": [
                    {
                      "name": "id",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--path-component",
                  "required": true,
                  "arguments": [
                    {
                      "name": "component",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--query-upstream",
                  "arguments": [
                    {
                      "name": "upstream",
                      "required": true
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "GET",
                      "path": "/nodes/{id}/updates/{component}/releases",
                      "parameters": [
                        {
                          "name": "id",
                          "in": "path",
                          "option": "--path-id",
                          "required": true,
                          "schema": {
                            "type": "string"
                          }
                        },
                        {
                          "name": "component",
                          "in": "path",
                          "option": "--path-component",
                          "required": true,
                          "schema": {
                            "type": "string",
                            "enum": [
                              "management",
                              "host"
                            ]
                          }
                        },
                        {
                          "name": "upstream",
                          "in": "query",
                          "option": "--query-upstream",
                          "schema": {
                            "type": "string"
                          }
                        }
                      ],
                      "accept": "application/json"
                    },
                    "api": [
                      {
                        "operationId": "listUpdateReleases",
                        "inputs": {
                          "path/id": "option:--path-id",
                          "path/component": "option:--path-component",
                          "query/upstream": "option:--query-upstream"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "name": "runUpdateAction",
              "description": "Request a hostd-coordinated appliance update action",
              "options": [
                {
                  "name": "--path-id",
                  "required": true,
                  "arguments": [
                    {
                      "name": "id",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--path-component",
                  "required": true,
                  "arguments": [
                    {
                      "name": "component",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--path-action",
                  "required": true,
                  "arguments": [
                    {
                      "name": "action",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--header-idempotency-key",
                  "arguments": [
                    {
                      "name": "Idempotency-Key",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--body",
                  "description": "Request body: JSON for JSON media, literal text otherwise; mutually exclusive with --body-file",
                  "arguments": [
                    {
                      "name": "body",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--body-file",
                  "description": "Read the request body from a file as raw bytes (CLI only); mutually exclusive with --body",
                  "arguments": [
                    {
                      "name": "path",
                      "required": true,
                      "metadata": [
                        {
                          "name": "floatlab",
                          "value": {
                            "provider": "files"
                          }
                        }
                      ]
                    }
                  ],
                  "metadata": [
                    {
                      "name": "floatlab",
                      "value": {
                        "capability": "files"
                      }
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "POST",
                      "path": "/nodes/{id}/updates/{component}/{action}",
                      "parameters": [
                        {
                          "name": "id",
                          "in": "path",
                          "option": "--path-id",
                          "required": true,
                          "schema": {
                            "type": "string"
                          }
                        },
                        {
                          "name": "component",
                          "in": "path",
                          "option": "--path-component",
                          "required": true,
                          "schema": {
                            "type": "string",
                            "enum": [
                              "management",
                              "host"
                            ]
                          }
                        },
                        {
                          "name": "action",
                          "in": "path",
                          "option": "--path-action",
                          "required": true,
                          "schema": {
                            "type": "string",
                            "enum": [
                              "start",
                              "prepare",
                              "activate",
                              "commit",
                              "rollback",
                              "cleanup"
                            ]
                          }
                        },
                        {
                          "name": "Idempotency-Key",
                          "in": "header",
                          "option": "--header-idempotency-key",
                          "required": true,
                          "schema": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 255
                          }
                        }
                      ],
                      "requestBody": {
                        "required": true,
                        "content": {
                          "application/json": {
                            "schema": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "release": {
                                  "type": "string",
                                  "description": "Immutable release tag for start/prepare."
                                },
                                "upstream": {
                                  "type": "string",
                                  "description": "GitHub owner/repo for start/prepare; defaults to floatlab-hq/floatlab-core. Images are pinned by its manifest."
                                },
                                "skip_dry_run": {
                                  "type": "boolean",
                                  "default": false,
                                  "description": "Skip the isolated preflight trial on start/prepare. Validation and rollback protection remain enabled."
                                },
                                "operation_id": {
                                  "type": "string",
                                  "description": "Existing transaction for subsequent actions; defaults to the idempotency key on start/prepare."
                                }
                              }
                            }
                          }
                        }
                      },
                      "accept": "application/json"
                    },
                    "api": [
                      {
                        "operationId": "runUpdateAction",
                        "inputs": {
                          "path/id": "option:--path-id",
                          "path/component": "option:--path-component",
                          "path/action": "option:--path-action",
                          "header/Idempotency-Key": "option:--header-idempotency-key",
                          "body": "option:--body"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]

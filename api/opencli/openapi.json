{
  "commands": [
    {
      "name": "api",
      "description": "Call the HTTP API directly",
      "commands": [
        {
          "name": "openapi",
          "commands": [
            {
              "name": "receiveMetricsAlerts",
              "description": "Receive internal vmalert Alertmanager alerts",
              "options": [
                {
                  "name": "--body",
                  "description": "Request body: JSON for JSON media, literal text otherwise; mutually exclusive with --body-file",
                  "arguments": [
                    {
                      "name": "body",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--body-file",
                  "description": "Read the request body from a file as raw bytes (CLI only); mutually exclusive with --body",
                  "arguments": [
                    {
                      "name": "path",
                      "required": true,
                      "metadata": [
                        {
                          "name": "floatlab",
                          "value": {
                            "provider": "files"
                          }
                        }
                      ]
                    }
                  ],
                  "metadata": [
                    {
                      "name": "floatlab",
                      "value": {
                        "capability": "files"
                      }
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "POST",
                      "path": "/stats/webhook",
                      "parameters": [],
                      "requestBody": {
                        "required": true,
                        "content": {
                          "application/json": {
                            "schema": {
                              "type": "object",
                              "required": [
                                "alerts"
                              ],
                              "properties": {
                                "alerts": {
                                  "type": "array",
                                  "items": {
                                    "type": "object"
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "public": true
                    },
                    "api": [
                      {
                        "operationId": "receiveMetricsAlerts",
                        "inputs": {
                          "body": "option:--body"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "name": "streamEvents",
              "description": "Subscribe to lifecycle and notification events",
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "GET",
                      "path": "/events",
                      "parameters": [],
                      "accept": "text/event-stream"
                    },
                    "api": [
                      {
                        "operationId": "streamEvents",
                        "inputs": {}
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}

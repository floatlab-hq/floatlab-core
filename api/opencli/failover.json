{
  "commands": [
    {
      "name": "api",
      "description": "Call the HTTP API directly",
      "commands": [
        {
          "name": "failover",
          "commands": [
            {
              "name": "abortFailover",
              "description": "Abort an in-progress failover",
              "options": [
                {
                  "name": "--path-stack-id",
                  "required": true,
                  "arguments": [
                    {
                      "name": "stack_id",
                      "required": true
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "POST",
                      "path": "/failover/{stack_id}/abort",
                      "parameters": [
                        {
                          "name": "stack_id",
                          "in": "path",
                          "option": "--path-stack-id",
                          "required": true,
                          "schema": {
                            "type": "string",
                            "format": "uuid"
                          }
                        }
                      ]
                    },
                    "api": [
                      {
                        "operationId": "abortFailover",
                        "inputs": {
                          "path/stack_id": "option:--path-stack-id"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {

              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "GET",
                      "path": "/failover/{stack_id}/log",
                      "parameters": [
                        {
                          "name": "stack_id",
                          "in": "path",
                          "option": "--path-stack-id",
                          "required": true,
                          "schema": {
                            "type": "string",
                            "format": "uuid"
                          }

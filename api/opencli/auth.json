{
  "commands": [
    {
      "name": "api",
      "description": "Call the HTTP API directly",
      "commands": [
        {
          "name": "auth",
          "commands": [
            {
              "name": "createAuthToken",
              "description": "Exchange user credentials for an administrator JWT",
              "options": [
                {
                  "name": "--body",
                  "description": "Request body: JSON for JSON media, literal text otherwise; mutually exclusive with --body-file",
                  "arguments": [
                    {
                      "name": "body",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--body-file",
                  "description": "Read the request body from a file as raw bytes (CLI only); mutually exclusive with --body",
                  "arguments": [
                    {
                      "name": "path",
                      "required": true,
                      "metadata": [
                        {
                          "name": "floatlab",
                          "value": {
                            "provider": "files"
                          }
                        }
                      ]
                    }
                  ],
                  "metadata": [
                    {
                      "name": "floatlab",
                      "value": {
                        "capability": "files"
                      }
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "POST",
                      "path": "/auth/token",
                      "parameters": [],
                      "requestBody": {
                        "required": true,
                        "content": {
                          "application/json": {
                            "schema": {
                              "type": "object",
                              "required": [
                                "username",
                                "password"
                              ],
                              "additionalProperties": false,
                              "properties": {
                                "username": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 64
                                },
                                "password": {
                                  "type": "string",
                                  "format": "password",
                                  "minLength": 1,
                                  "maxLength": 72
                                },
                                "totp_code": {
                                  "type": "string",
                                  "pattern": "^[0-9]{6}$",
                                  "description": "Required for TOTP-enrolled accounts unless a recovery code is supplied."
                                },
                                "recovery_code": {
                                  "type": "string",
                                  "description": "A single-use recovery code; mutually exclusive with totp_code."
                                }
                              }
                            }
                          }
                        }
                      },
                      "public": true,
                      "accept": "application/json"
                    },
                    "api": [
                      {
                        "operationId": "createAuthToken",
                        "inputs": {
                          "body": "option:--body"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}

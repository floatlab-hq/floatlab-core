{
  "commands": [
    {
      "name": "failover",
      "description": "Recover a stack on its nominated secondary",
      "commands": [
        {
          "name": "preview",
          "description": "Show the verified recovery point and possible data loss",
          "arguments": [{ "name": "stack", "required": true, "metadata": [{ "name": "floatlab", "value": { "provider": "stacks" } }] }],
          "metadata": [{ "name": "floatlab", "value": { "api": [{ "operationId": "previewStackFailover", "inputs": { "path/stack_id": "argument:stack", "query/destination_node_id": "derived:secondary_node" } }] } }]
        },
        {
          "name": "trigger",
          "description": "Start recovery using the reviewed recovery point after fencing the primary",
          "arguments": [{ "name": "stack", "required": true, "metadata": [{ "name": "floatlab", "value": { "provider": "stacks" } }] }],
          "options": [
            { "name": "--primary-fenced", "required": true, "description": "Confirm the old primary cannot run the workload" },
            { "name": "--recovery-point", "required": true, "arguments": [{ "name": "token", "required": true }] },
            { "name": "--name", "description": "New stack name for a two-node clone", "arguments": [{ "name": "name", "required": true }] },
            { "name": "--network-pool", "description": "Destination-owned pool for the recovered stack's new physical-network IP and MAC", "arguments": [{ "name": "pool", "required": true }] }
          ],
          "metadata": [{ "name": "floatlab", "value": { "api": [{ "operationId": "triggerStackFailover", "inputs": { "path/stack_id": "argument:stack", "header/Idempotency-Key": "runtime:uuid", "body/destination_node_id": "derived:secondary_node", "body/primary_fenced": "option:--primary-fenced", "body/recovery_point": "option:--recovery-point", "body/name": "option:--name", "body/network_pool": "option:--network-pool" } }] } }]
        }
      ]
    },
    {
      "name": "install-autocomplete",
      "description": "Install bundled autocomplete for your shell (defaults to SHELL)",
      "arguments": [{ "name": "shell", "acceptedValues": ["bash", "fish", "ps1", "nu", "powershell", "nushell", "pwsh"] }],
      "metadata": [{ "name": "floatlab", "value": { "utility": true, "capability": "cli" } }]
    },
    {
      "name": "help",
      "description": "help",
      "arguments": [
        {
          "name": "command",
          "required": false,
          "arity": {
            "minimum": 0
          }
        }
      ],
      "metadata": [
        {
          "name": "floatlab",
          "value": {
            "utility": true
          }
        }
      ]
    },
    {

{
  "commands": [
    {
      "name": "api",
      "description": "Call the HTTP API directly",
      "commands": [
        {
          "name": "host-network",
          "commands": [
            {
              "name": "applyHostNetwork",
              "description": "Apply network settings with a 60-second confirmation deadline",
              "options": [
                {
                  "name": "--path-id",
                  "required": true,
                  "arguments": [
                    {
                      "name": "id",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--header-idempotency-key",
                  "arguments": [
                    {
                      "name": "Idempotency-Key",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--body",
                  "description": "Request body: JSON for JSON media, literal text otherwise; mutually exclusive with --body-file",
                  "arguments": [
                    {
                      "name": "body",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--body-file",
                  "description": "Read the request body from a file as raw bytes (CLI only); mutually exclusive with --body",
                  "arguments": [
                    {
                      "name": "path",
                      "required": true,
                      "metadata": [
                        {
                          "name": "floatlab",
                          "value": {
                            "provider": "files"
                          }
                        }
                      ]
                    }
                  ],
                  "metadata": [
                    {
                      "name": "floatlab",
                      "value": {
                        "capability": "files"
                      }
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "PUT",
                      "path": "/nodes/{id}/settings/network",
                      "parameters": [
                        {
                          "name": "id",
                          "in": "path",
                          "option": "--path-id",
                          "required": true,
                          "schema": {
                            "type": "string"
                          }
                        },
                        {
                          "name": "Idempotency-Key",
                          "in": "header",
                          "option": "--header-idempotency-key",
                          "required": true,
                          "schema": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 255
                          }
                        }
                      ],
                      "requestBody": {
                        "required": true,
                        "content": {
                          "application/json": {
                            "schema": {
                              "type": "object",
                              "required": [
                                "revision",
                                "config"
                              ],
                              "additionalProperties": false,
                              "properties": {
                                "revision": {
                                  "type": "string"
                                },
                                "config": {
                                  "type": "object",
                                  "required": [
                                    "version",
                                    "excluded_macs",
                                    "bonds",
                                    "ipv4",
                                    "dns_servers"
                                  ],
                                  "additionalProperties": false,
                                  "properties": {
                                    "version": {
                                      "type": "integer",
                                      "enum": [
                                        1
                                      ]
                                    },
                                    "excluded_macs": {
                                      "type": "array",
                                      "uniqueItems": true,
                                      "items": {
                                        "type": "string"
                                      }
                                    },
                                    "bonds": {
                                      "type": "array",
                                      "items": {
                                        "type": "object",
                                        "required": [
                                          "name",
                                          "mode",
                                          "members"
                                        ],
                                        "additionalProperties": false,
                                        "properties": {
                                          "name": {
                                            "type": "string",
                                            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,14}$"
                                          },
                                          "mode": {
                                            "type": "string",
                                            "enum": [
                                              "802.3ad"
                                            ]
                                          },
                                          "members": {
                                            "type": "array",
                                            "minItems": 2,
                                            "uniqueItems": true,
                                            "items": {
                                              "type": "string",
                                              "description": "Permanent Ethernet MAC address"
                                            }
                                          }
                                        }
                                      }
                                    },
                                    "ipv4": {
                                      "type": "object",
                                      "required": [
                                        "mode"
                                      ],
                                      "additionalProperties": false,
                                      "properties": {
                                        "mode": {
                                          "type": "string",
                                          "enum": [
                                            "dhcp",
                                            "static"
                                          ]
                                        },
                                        "address": {
                                          "type": "string",
                                          "format": "ipv4"
                                        },
                                        "netmask": {
                                          "type": "string",
                                          "format": "ipv4"
                                        },
                                        "gateway": {
                                          "type": "string",
                                          "format": "ipv4"
                                        }
                                      }
                                    },
                                    "dns_servers": {
                                      "type": "array",
                                      "description": "Fresh-install default: 1.1.1.1 and 8.8.8.8. Empty allows DHCP DNS.",
                                      "items": {
                                        "type": "string"
                                      }
                                    },
                                    "default_pool_id": {
                                      "type": "string"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "accept": "application/json"
                    },
                    "api": [
                      {
                        "operationId": "applyHostNetwork",
                        "inputs": {
                          "path/id": "option:--path-id",
                          "header/Idempotency-Key": "option:--header-idempotency-key",
                          "body": "option:--body"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "name": "confirmHostNetworkChange",
              "description": "Confirm a host network transaction",
              "options": [
                {
                  "name": "--path-id",
                  "required": true,
                  "arguments": [
                    {
                      "name": "id",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--path-change",
                  "required": true,
                  "arguments": [
                    {
                      "name": "change",
                      "required": true
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "POST",
                      "path": "/nodes/{id}/settings/network/changes/{change}/confirm",
                      "parameters": [
                        {
                          "name": "id",
                          "in": "path",
                          "option": "--path-id",
                          "required": true,
                          "schema": {
                            "type": "string"
                          }
                        },
                        {
                          "name": "change",
                          "in": "path",
                          "option": "--path-change",
                          "required": true,
                          "schema": {
                            "type": "string",
                            "format": "uuid"
                          }
                        }
                      ],
                      "accept": "application/json"
                    },
                    "api": [
                      {
                        "operationId": "confirmHostNetworkChange",
                        "inputs": {
                          "path/id": "option:--path-id",
                          "path/change": "option:--path-change"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "name": "getHostNetwork",
              "description": "Read confirmed and effective host network settings",
              "options": [
                {
                  "name": "--path-id",
                  "required": true,
                  "arguments": [
                    {
                      "name": "id",
                      "required": true
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "GET",
                      "path": "/nodes/{id}/settings/network",
                      "parameters": [
                        {
                          "name": "id",
                          "in": "path",
                          "option": "--path-id",
                          "required": true,
                          "schema": {
                            "type": "string"
                          }
                        }
                      ],
                      "accept": "application/json"
                    },
                    "api": [
                      {
                        "operationId": "getHostNetwork",
                        "inputs": {
                          "path/id": "option:--path-id"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "name": "getHostNetworkChange",
              "description": "Read a host network transaction",
              "options": [
                {
                  "name": "--path-id",
                  "required": true,
                  "arguments": [
                    {
                      "name": "id",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--path-change",
                  "required": true,
                  "arguments": [
                    {
                      "name": "change",
                      "required": true
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "GET",
                      "path": "/nodes/{id}/settings/network/changes/{change}",
                      "parameters": [
                        {
                          "name": "id",
                          "in": "path",
                          "option": "--path-id",
                          "required": true,
                          "schema": {
                            "type": "string"
                          }
                        },
                        {
                          "name": "change",
                          "in": "path",
                          "option": "--path-change",
                          "required": true,
                          "schema": {
                            "type": "string",
                            "format": "uuid"
                          }
                        }
                      ],
                      "accept": "application/json"
                    },
                    "api": [
                      {
                        "operationId": "getHostNetworkChange",
                        "inputs": {
                          "path/id": "option:--path-id",
                          "path/change": "option:--path-change"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "name": "rollbackHostNetworkChange",
              "description": "Rollback a host network transaction",
              "options": [
                {
                  "name": "--path-id",
                  "required": true,
                  "arguments": [
                    {
                      "name": "id",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--path-change",
                  "required": true,
                  "arguments": [
                    {
                      "name": "change",
                      "required": true
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "POST",
                      "path": "/nodes/{id}/settings/network/changes/{change}/rollback",
                      "parameters": [
                        {
                          "name": "id",
                          "in": "path",
                          "option": "--path-id",
                          "required": true,
                          "schema": {
                            "type": "string"
                          }
                        },
                        {
                          "name": "change",
                          "in": "path",
                          "option": "--path-change",
                          "required": true,
                          "schema": {
                            "type": "string",
                            "format": "uuid"
                          }
                        }
                      ],
                      "accept": "application/json"
                    },
                    "api": [
                      {
                        "operationId": "rollbackHostNetworkChange",
                        "inputs": {
                          "path/id": "option:--path-id",
                          "path/change": "option:--path-change"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}

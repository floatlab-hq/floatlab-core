            {
              "name": "createAlertRule",
              "description": "Create an alert rule",
              "options": [
                {
                  "name": "--body",
                  "description": "Request body: JSON for JSON media, literal text otherwise; mutually exclusive with --body-file",
                  "arguments": [
                    {
                      "name": "body",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--body-file",
                  "description": "Read the request body from a file as raw bytes (CLI only); mutually exclusive with --body",
                  "arguments": [
                    {
                      "name": "path",
                      "required": true,
                      "metadata": [
                        {
                          "name": "floatlab",
                          "value": {
                            "provider": "files"
                          }
                        }
                      ]
                    }
                  ],
                  "metadata": [
                    {
                      "name": "floatlab",
                      "value": {
                        "capability": "files"
                      }
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "POST",
                      "path": "/alert-rules",
                      "parameters": [],
                      "requestBody": {
                        "required": true,
                        "content": {
                          "application/json": {
                            "schema": {
                              "type": "object",
                              "required": [
                                "name",
                                "condition",
                                "recovery_condition",
                                "freshness_query",
                                "severity"
                              ],
                              "properties": {
                                "name": {
                                  "type": "string"
                                },
                                "condition": {
                                  "type": "string",
                                  "description": "Filtered MetricsQL predicate. Every returned series is a match, including a zero-valued\nsample. Use filtering comparisons, not the bool modifier. Empty results are unknown,\nnot recovery. Configure recovery_condition to resolve on positive healthy evidence.\nAggregate away volatile labels such as container_id for stable resource identity.\n",
                                  "example": "cpu_usage_percent > 90"
                                },
                                "severity": {
                                  "type": "string",
                                  "enum": [
                                    "info",
                                    "warning",
                                    "critical"
                                  ]
                                },
                                "stack_id": {
                                  "type": "string",
                                  "format": "uuid",
                                  "nullable": true
                                },
                                "node_id": {
                                  "type": "string",
                                  "format": "uuid",
                                  "nullable": true
                                },
                                "for_duration": {
                                  "type": "string",
                                  "example": "5m"
                                },
                                "freshness_query": {
                                  "type": "string",
                                  "description": "MetricsQL query returning source observation Unix timestamps with the same resource labels. Required for enabled rules; derived queries must return the oldest required source timestamp."
                                },
                                "recovery_condition": {
                                  "type": "string",
                                  "description": "Filtered healthy predicate with the same resource labels as condition. Required for enabled rules; missing telemetry never resolves an incident.",
                                  "example": "cpu_usage_percent < 85"
                                },
                                "recovery_duration": {
                                  "type": "string",
                                  "default": "1m",
                                  "description": "Duration of fresh healthy evidence required to resolve; Go duration syntax, zero allowed."
                                },
                                "max_sample_age": {
                                  "type": "string",
                                  "default": "2m",
                                  "description": "Maximum observation age and implicit MetricsQL lookback; positive Go duration."
                                },
                                "annotations": {
                                  "type": "object",
                                  "additionalProperties": {
                                    "type": "string"
                                  }
                                },
                                "enabled": {
                                  "type": "boolean",
                                  "default": true
                                }
                              }
                            }
                          }
                        }
                      },
                      "accept": "application/json"
                    },
                    "api": [
                      {
                        "operationId": "createAlertRule",
                        "inputs": {
                          "body": "option:--body"
                        }
                      }
                    ]
                  }
                }
              ]

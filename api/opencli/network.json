        {
          "name": "network",
          "commands": [
            {
              "name": "createAllocation",
              "description": "Allocate an IPv6 address for a container service",
              "options": [
                {
                  "name": "--body",
                  "description": "Request body: JSON for JSON media, literal text otherwise; mutually exclusive with --body-file",
                  "arguments": [
                    {
                      "name": "body",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--body-file",
                  "description": "Read the request body from a file as raw bytes (CLI only); mutually exclusive with --body",
                  "arguments": [
                    {
                      "name": "path",
                      "required": true,
                      "metadata": [
                        {
                          "name": "floatlab",
                          "value": {
                            "provider": "files"
                          }
                        }
                      ]
                    }
                  ],
                  "metadata": [
                    {
                      "name": "floatlab",
                      "value": {
                        "capability": "files"
                      }
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "POST",
                      "path": "/network/allocations",
                      "parameters": [],
                      "requestBody": {
                        "required": true,
                        "content": {
                          "application/json": {
                            "schema": {
                              "type": "object",
                              "required": [
                                "stack_id",
                                "service",
                                "prefix_pool"
                              ],
                              "properties": {
                                "stack_id": {
                                  "type": "string",
                                  "format": "uuid"
                                },
                                "service": {
                                  "type": "string"
                                },
                                "prefix_pool": {
                                  "type": "string",
                                  "format": "uuid"
                                },
                                "address": {
                                  "type": "string",
                                  "nullable": true,
                                  "description": "Request a specific address. Omit for auto-allocation."
                                }
                              }
                            }
                          }
                        }
                      },
                      "accept": "application/json"
                    },
                    "api": [
                      {
                        "operationId": "createAllocation",
                        "inputs": {
                          "body": "option:--body"
                        }
                      }
                    ]
                  }
                }
              ]
            },

                {
                  "name": "--body",
                  "description": "Request body: JSON for JSON media, literal text otherwise; mutually exclusive with --body-file",
                  "arguments": [
                    {
                      "name": "body",
                      "required": true
                    }
                  ]
                },
                {
                  "name": "--body-file",
                  "description": "Read the request body from a file as raw bytes (CLI only); mutually exclusive with --body",
                  "arguments": [
                    {
                      "name": "path",
                      "required": true,
                      "metadata": [
                        {
                          "name": "floatlab",
                          "value": {
                            "provider": "files"
                          }
                        }
                      ]
                    }
                  ],
                  "metadata": [
                    {
                      "name": "floatlab",
                      "value": {
                        "capability": "files"
                      }
                    }
                  ]
                }
              ],
              "metadata": [
                {
                  "name": "floatlab",
                  "value": {
                    "http": {
                      "method": "POST",
                      "path": "/notifications",
                      "parameters": [],
                      "requestBody": {
                        "required": true,
                        "content": {
                          "application/json": {
                            "schema": {
                              "type": "object",
                              "required": [
                                "severity",
                                "title",
                                "body"
                              ],
                              "properties": {
                                "alert_id": {
                                  "type": "string",
                                  "format": "uuid",
                                  "nullable": true
                                },
                                "kind": {
                                  "type": "string"
                                },
                                "severity": {
                                  "type": "string",
                                  "enum": [
                                    "info",
                                    "warning",
                                    "critical"
                                  ]
                                },
                                "title": {
                                  "type": "string"
                                },
                                "body": {
                                  "type": "string"
                                },
                                "stack_id": {
                                  "type": "string",
                                  "format": "uuid",
                                  "nullable": true
                                },
                                "node_id": {
                                  "type": "string",
                                  "format": "uuid",
                                  "nullable": true
                                }
                              }
                            }
                          }
                        }
                      },
                      "accept": "application/json"
                    },
                    "api": [
                      {
                        "operationId": "createNotification",
                        "inputs": {
                          "body": "option:--body"
